generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model permissions {
  id               Int                @id @default(autoincrement())
  action_code      String             @unique @db.VarChar(50)
  description      String?            @db.VarChar(255)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
}

model roles {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model user_roles {
  user_id String @db.Uuid
  role_id Int
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_role")
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user")

  @@id([user_id, role_id])
}

model users {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String        @unique @db.VarChar(50)
  password_hash String        @db.VarChar(255)
  email         String        @unique @db.VarChar(100)
  is_active     Boolean       @default(true)
  forms         forms[]
  submissions   submissions[]
  user_roles    user_roles[]
}

model fields {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form_id            String               @db.Uuid
  label              String               @db.VarChar(255)
  type               String               @db.VarChar(20)
  order              Int                  @default(0)
  is_required        Boolean              @default(false)
  options            Json?
  forms              forms                @relation(fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fields_form")
  submission_answers submission_answers[]
}

model forms {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String        @db.VarChar(255)
  description String?
  order       Int           @default(0)
  status      String        @default("draft") @db.VarChar(20)
  created_by  String        @db.Uuid
  fields      fields[]
  users       users         @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_forms_created_by")
  submissions submissions[]
}

model submission_answers {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id String      @db.Uuid
  field_id      String      @db.Uuid
  value         String
  fields        fields      @relation(fields: [field_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answers_field")
  submissions   submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answers_submission")
}

model submissions {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form_id            String               @db.Uuid
  user_id            String               @db.Uuid
  submitted_at       DateTime             @default(now()) @db.Timestamp(6)
  submission_answers submission_answers[]
  forms              forms                @relation(fields: [form_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_submissions_form")
  users              users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_submissions_user")
}
